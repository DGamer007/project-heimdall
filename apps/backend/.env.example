# ============================================================================
# Heimdall Backend Configuration
# ============================================================================
#
# Primary configuration is managed through config.yaml
#
# Environment variables can be used to override config.yaml values.
# Use the same nesting structure with underscore (_) as separator.
#
# Format: SECTION_SUBSECTION_PROPERTY=value
#
# Examples:
#   config.yaml:                    Environment Variable Override:
#   -------------                   ------------------------------
#   server:
#     port: 4000                    SERVER_PORT=8080
#     gin_mode: test                SERVER_GIN_MODE=release
#
#   auth:
#     jwt:
#       issuer: localhost           AUTH_JWT_ISSUER=auth.example.com
#       access_token:
#         secret: xxx               AUTH_JWT_ACCESS_TOKEN_SECRET=my-secret
#         ttl: 15m                  AUTH_JWT_ACCESS_TOKEN_TTL=30m
#
# ============================================================================


# ============================================================================
# The variables below are required by Docker Compose and CLI tools (e.g., pg-goose)
# They also override their corresponding config.yaml values
# ============================================================================

# Database - PostgreSQL
DATABASE_POSTGRES_HOST=
DATABASE_POSTGRES_PORT=
DATABASE_POSTGRES_USER=
DATABASE_POSTGRES_PASSWORD=
DATABASE_POSTGRES_DB_NAME=
